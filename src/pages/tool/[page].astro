---
import { getCollection,render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const tools = await getCollection("tools");
  
  return tools.map((tool:CollectionEntry<"tools">) => ({
  params: {
    page: tool.id,
  },
  props: { tool },
}));
}

const { tool } = Astro.props as {
  tool: CollectionEntry<"tools">;
};

const { Content } = await render(tool);
---

<html>
<head>
  <title>{tool.data.title} | {tool.data.category}</title>
  <meta name="description" content={tool.data.description}>
  <meta name="keywords" content={tool.data.tags.join(', ')}>
</head>

<body>
  <Content />
</body>
</html>