---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { BASE_URL } from "../../util/config";

export async function getStaticPaths() {
  const tools = await getCollection("tools");
  return tools.map((tool) => ({
    params: { tool: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const { title, description, tags, category, image, url } = tool.data;
const { Content } = await render(tool);
---

<Layout title={`${title} — ToolHub`} description={description}>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <div>
      <a href={`${BASE_URL}/`} class="font-mono text-xs text-ink-soft hover:text-accent">&larr; Back to ToolHub</a>
    </div>

    <div class="mt-6">
      <span class="index-tab w-fit">{category}</span>
    </div>

    <h1 class="mt-4 font-display text-3xl font-bold text-ink">{title}</h1>
    <p class="mt-3 text-base text-ink-soft">{description}</p>

    {image && (
      <img
        src={image}
        alt={title}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="mt-8 max-h-80 w-full rounded-md border border-line bg-surface object-contain"
      />
    )}

    {url && (
      <div class="mt-8 rounded-lg border border-line bg-surface p-4">
        <div class="flex flex-col gap-4 sm:flex-row items-center justify-between">
          <div>
            <p class="font-mono text-sm text-accent-2">
              {url}
            </p>
          </div>

          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md border-2 border-accent px-4 py-2 text-sm font-semibold text-ink transition hover:bg-accent"
          >
            Open Website
          </a>
        </div>
      </div>
    )}

    <div class="prose-toolhub prose prose-sm mt-10">
      <Content />
    </div>

    {tags.length > 0 && (
      <div class="mt-10 flex flex-wrap gap-2">
        {tags.map((tag) => <span class="font-mono text-xs text-ink-soft">#{tag}</span>)}
      </div>
    )}
  </main>
</Layout>

<script define:vars={{toolId: tool.id}}>
  function addRecent(id) {
    const current = JSON.parse(localStorage.getItem("toolhub:recentlyViewed") ?? "[]")?.filter((h) => h !== id);
    current.unshift(id);
    localStorage.setItem("toolhub:recentlyViewed", JSON.stringify(current.slice(0, 6)));
  }
  addRecent(toolId);
</script>