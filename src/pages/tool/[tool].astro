---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { BASE_URL } from "../../util/config";
import { slugify } from "../../util/slugify";
import TableOfContents from "../../components/TableOfContents.astro";

export async function getStaticPaths() {
  const tools = await getCollection("tools");
  return tools.map((tool) => ({
    params: { tool: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const { title, description, tags, category, image, url } = tool.data;
const { Content, headings } = await render(tool);
---

<Layout title={`${title} - ToolHub`} description={description} keywords={tags}>
  <div class="mx-auto flex justify-center max-w-6xl gap-10 px-6 lg:justify-between">
    <section class="min-w-0 max-w-3xl flex-1 py-10">
      <nav aria-label="Breadcrumb" class="mx-auto max-w-6xl pb-3 font-mono text-xs text-ink-soft">
        <a href={`${BASE_URL}/`} class="hover:text-accent">Home</a>
        <span class="mx-1">/</span>
        <a href={`${BASE_URL}/category/${slugify(category)}`} class="hover:text-accent">{category}</a>
        <span class="mx-1">/</span>
        <span class="text-ink">{title}</span>
      </nav>

      <h1 class="mt-4 font-display text-3xl font-bold text-ink">{title}</h1>
      <p class="mt-3 text-base text-ink-soft">{description}</p>

      {image && (
        <img
          src={image}
          alt={title}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="mt-8 max-h-80 w-full rounded-md border border-line bg-surface object-contain"
        />
      )}

      {url && (
        <div class="mt-8 rounded-lg border border-line bg-surface p-4">
          <div class="flex flex-col gap-4 sm:flex-row items-center justify-between">
            <div>
              <p class="font-mono text-sm wrap-anywhere text-accent-2">
                {url}
              </p>
            </div>

            <a
              href={url}
              target="_blank"
              rel="noopener"
              class="rounded-md border-2 border-accent px-4 py-2 text-sm font-semibold text-ink transition hover:bg-accent"
            >
              Open Website
            </a>
          </div>
        </div>
      )}

      <div class="prose-toolhub prose prose-sm mt-10">
        <Content />
      </div>

      {tags.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-2">
          {tags.map((tag) => <a href={`${BASE_URL}/tag/${slugify(tag)}`}><span class="font-mono text-xs text-ink-soft hover:text-accent">#{tag}</span></a>)}
        </div>
      )}
    </section>
    <aside class="hidden w-56 shrink-0 py-10 lg:block">
      <TableOfContents headings={headings} />
    </aside>
  </div>

  <script define:vars={{toolId: tool.id}}>
    function addRecent(id) {
      const current = JSON.parse(localStorage.getItem("toolhub:recentlyViewed") ?? "[]")?.filter((h) => h !== id);
      current.unshift(id);
      localStorage.setItem("toolhub:recentlyViewed", JSON.stringify(current.slice(0, 6)));
    }
    addRecent(toolId);
  </script>
  
</Layout>