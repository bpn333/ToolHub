---
import Layout from "../layouts/Layout.astro";
import ToolCard from "../components/ToolCard.astro";
import { getCollection } from "astro:content";
import { BASE_URL } from "../util/config";

const allTools = await getCollection("tools");
const categories = [...new Set(allTools.map((t) => t.data.category))].sort((a, b) =>
  a.localeCompare(b)
);

const grouped = categories.map((category) => ({
  category,
  tools: allTools.filter((t) => t.data.category === category),
}));

const toolCount = allTools.length;
const categoryCount = categories.length;

// Serializable data for client-side search + recently-viewed.
// NOTE: adjust `href` below if your tool detail page uses a different route.
const toolsData = allTools.map((t) => ({
  id: t.id,
  title: t.data.title,
  description: t.data.description,
  tags: t.data.tags,
  category: t.data.category,
  image: t.data.image ?? null,
  url: t.data.url ?? null,
  href: `${BASE_URL}/tool/${t.id}`,
}));
---

<Layout>
  <header class="sticky top-0 z-30 border-b border-line bg-paper/90 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href={`${BASE_URL}/`} class="font-display text-2xl font-bold tracking-tight text-ink">
        Tool<span class="text-accent">Hub</span>
      </a>
      <button
        id="theme-toggle"
        aria-label="Toggle color theme"
        class="flex h-9 w-9 items-center justify-center rounded-md border border-line text-ink transition hover:border-accent"
      >
        <svg class="dark:hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="hidden dark:block h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
        </svg>
      </button>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <!-- IMPORTANT: overflow-hidden lives on the decorative background layer only,
         NOT on this outer section — otherwise the search dropdown gets clipped. -->
    <section class="relative">
      <div class="pointer-events-none absolute inset-0 overflow-hidden blueprint-grid"></div>

      <div class="relative mx-auto max-w-6xl px-6 py-20 sm:py-28">
        <div class="relative mx-auto max-w-3xl border border-line bg-surface/70 px-8 py-12 backdrop-blur sm:px-14 sm:py-16">
          <span class="crop-mark tl"></span>
          <span class="crop-mark tr"></span>
          <span class="crop-mark bl"></span>
          <span class="crop-mark br"></span>

          <span class="index-tab">Directory // {toolCount} tools</span>

          <h1 class="mt-6 font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink sm:text-5xl">
            Find the right tool.<br />
            Fast.
          </h1>

          <p class="mt-5 max-w-lg text-base leading-relaxed text-ink-soft">
            ToolHub is a hand-sorted shelf of {toolCount} tools across {categoryCount} categories.
            Search by name, tag, or category — no digging required.
          </p>

          <div class="relative mt-8">
            <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <input
              id="tool-search"
              type="text"
              autocomplete="off"
              placeholder="Search tools, tags, categories…"
              class="w-full rounded-md border border-line bg-surface py-3 pl-11 pr-4 font-body text-sm text-ink placeholder:text-ink-soft outline-none transition focus:border-accent"
            />
            <ul
              id="search-suggestions"
              class="absolute left-0 right-0 top-full z-50 mt-2 hidden max-h-80 overflow-y-auto rounded-md border border-line bg-surface shadow-xl"
            ></ul>
          </div>

          <p class="mt-4 font-mono text-xs text-ink-soft">
            Showing <span id="result-count">{toolCount}</span> of {toolCount} tools
          </p>
        </div>
      </div>
    </section>

    <!-- RECENTLY VIEWED -->
    <section id="recent-section" class="hidden border-b border-line bg-surface">
      <div class="mx-auto max-w-6xl px-6 py-10">
        <div class="mb-6 flex items-center gap-4">
          <span class="index-tab">Recently Viewed</span>
          <span class="h-px flex-1 bg-line"></span>
          <button id="clear-recent" class="font-mono text-xs text-ink-soft hover:text-accent">
            Clear
          </button>
        </div>
        <div id="recent-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>
      </div>
    </section>

    <!-- CATEGORY CHIPS -->
    <section class="border-y border-line bg-surface">
      <div class="mx-auto flex max-w-6xl gap-2 overflow-x-auto px-6 py-4">
        <button class="category-chip is-active" data-category="all">All</button>
        {categories.map((category) => (
          <button class="category-chip" data-category={category}>{category}</button>
        ))}
      </div>
    </section>

    <!-- TOOL LISTING -->
    <section class="mx-auto max-w-6xl px-6 py-16">
      <div id="empty-state" class="hidden py-20 text-center">
        <p class="font-display text-lg font-semibold text-ink">No tools match that search.</p>
        <p class="mt-2 text-sm text-ink-soft">Try a different keyword or clear the filters.</p>
      </div>

      {grouped.map(({ category, tools }) => (
        <div class="category-section mb-14 last:mb-0" data-category={category}>
          <div class="mb-6 flex items-center gap-4">
            <span class="index-tab">{category}</span>
            <span class="h-px flex-1 bg-line"></span>
            <span class="font-mono text-xs text-ink-soft">
              {tools.length} tool{tools.length === 1 ? "" : "s"}
            </span>
          </div>
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {tools.map((tool) => (
              <ToolCard tool={tool} />
            ))}
          </div>
        </div>
      ))}
    </section>
  </main>

  <footer class="border-t border-line py-8">
    <div class="mx-auto max-w-6xl px-6 text-center font-mono text-xs text-ink-soft">
      ToolHub — {toolCount} tools, sorted and searchable.
    </div>
  </footer>

  <!-- Serialized tool data for client-side search + recently-viewed rendering -->
  <script type="application/json" id="tools-data" set:html={JSON.stringify(toolsData)} />
</Layout>

<script>
  type ToolRecord = {
    id: string;
    title: string;
    description: string;
    tags: string[];
    category: string;
    image: string | null;
    url: string | null;
    href: string;
  };

  const dataEl = document.getElementById("tools-data");
  const toolsData: ToolRecord[] = dataEl ? JSON.parse(dataEl.textContent ?? "[]") : [];

  // Precompute a lowercase search blob per tool once.
  const searchIndex = toolsData.map((t) => ({
    tool: t,
    blob: [t.title, t.description, t.category, ...(t.tags ?? [])].join(" ").toLowerCase(),
  }));

  const toolsById = new Map(toolsData.map((t) => [t.id, t]));

  // ---------------- Category chip filtering ----------------
  const chips = document.querySelectorAll<HTMLButtonElement>(".category-chip");
  const sections = document.querySelectorAll<HTMLElement>(".category-section");
  const emptyState = document.getElementById("empty-state");
  const resultCount = document.getElementById("result-count");
  const themeToggle = document.getElementById("theme-toggle");

  let activeCategory = "all";

  function applyFilters() {
    let visibleCount = 0;
    sections.forEach((section) => {
      let sectionHasVisible = false;
      section.querySelectorAll<HTMLElement>(".tool-card").forEach((card) => {
        const show = activeCategory === "all" || card.dataset.category === activeCategory;
        card.style.display = show ? "" : "none";
        if (show) {
          sectionHasVisible = true;
          visibleCount++;
        }
      });
      section.style.display = sectionHasVisible ? "" : "none";
    });
    if (resultCount) resultCount.textContent = String(visibleCount);
    if (emptyState) emptyState.classList.toggle("hidden", visibleCount !== 0);
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.classList.remove("is-active"));
      chip.classList.add("is-active");
      activeCategory = chip.dataset.category ?? "all";
      applyFilters();
    });
  });

  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });

  // ---------------- Search suggestions ----------------
  const searchInput = document.getElementById("tool-search") as HTMLInputElement | null;
  const suggestionsList = document.getElementById("search-suggestions") as HTMLUListElement | null;
  const SUGGESTION_MAX = 8;
  let activeSuggestionIndex = -1;

  function closeSuggestions() {
    if (!suggestionsList) return;
    suggestionsList.innerHTML = "";
    suggestionsList.classList.add("hidden");
    activeSuggestionIndex = -1;
  }

  function highlightSuggestion(index: number) {
    if (!suggestionsList) return;
    const items = suggestionsList.querySelectorAll<HTMLAnchorElement>("a[data-suggestion]");
    items.forEach((el, i) => el.classList.toggle("bg-paper", i === index));
    activeSuggestionIndex = index;
  }

  function renderSuggestions(query: string) {
    if (!suggestionsList) return;
    suggestionsList.innerHTML = "";

    if (!query) {
      closeSuggestions();
      return;
    }

    const matches = searchIndex
      .filter(({ blob }) => blob.includes(query))
      .slice(0, SUGGESTION_MAX)
      .map(({ tool }) => tool);

    if (matches.length === 0) {
      const li = document.createElement("li");
      li.className = "px-4 py-3 font-mono text-xs text-ink-soft";
      li.textContent = `No tools match "${query}"`;
      suggestionsList.appendChild(li);
      suggestionsList.classList.remove("hidden");
      return;
    }

    matches.forEach((t) => {
      const li = document.createElement("li");

      const a = document.createElement("a");
      a.href = t.href;
      a.dataset.suggestion = "true";
      a.dataset.toolId = t.id;
      a.className = "flex items-center justify-between gap-3 px-4 py-3 text-sm text-ink transition hover:bg-paper";

      const left = document.createElement("span");
      left.className = "min-w-0";

      const title = document.createElement("span");
      title.className = "block truncate font-medium";
      title.textContent = t.title;

      const desc = document.createElement("span");
      desc.className = "block truncate text-xs text-ink-soft";
      desc.textContent = t.description;

      left.appendChild(title);
      left.appendChild(desc);

      const cat = document.createElement("span");
      cat.className = "shrink-0 font-mono text-[10px] uppercase text-ink-soft";
      cat.textContent = t.category;

      a.appendChild(left);
      a.appendChild(cat);

      li.appendChild(a);
      suggestionsList.appendChild(li);
    });

    suggestionsList.classList.remove("hidden");
    activeSuggestionIndex = -1;
  }

  searchInput?.addEventListener("input", () => {
    const query = (searchInput.value ?? "").trim().toLowerCase();
    renderSuggestions(query);
  });

  searchInput?.addEventListener("focus", () => {
    const query = (searchInput.value ?? "").trim().toLowerCase();
    if (query) renderSuggestions(query);
  });

  searchInput?.addEventListener("keydown", (e) => {
    if (!suggestionsList || suggestionsList.classList.contains("hidden")) return;
    const items = suggestionsList.querySelectorAll<HTMLAnchorElement>("a[data-suggestion]");
    if (items.length === 0) return;

    if (e.key === "ArrowDown") {
      e.preventDefault();
      highlightSuggestion((activeSuggestionIndex + 1) % items.length);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      highlightSuggestion((activeSuggestionIndex - 1 + items.length) % items.length);
    } else if (e.key === "Enter") {
      if (activeSuggestionIndex >= 0) {
        e.preventDefault();
        items[activeSuggestionIndex].click();
      }
    } else if (e.key === "Escape") {
      closeSuggestions();
      searchInput.blur();
    }
  });

  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (searchInput?.contains(target) || suggestionsList?.contains(target)) return;
    closeSuggestions();
  });

  // ---------------- Recently viewed ----------------
  const RECENT_KEY = "toolhub:recentlyViewed";
  const recentSection = document.getElementById("recent-section");
  const recentGrid = document.getElementById("recent-grid");
  const clearRecentBtn = document.getElementById("clear-recent");

  function renderRecent() {
    if (!recentGrid || !recentSection) return;

    const ids = JSON.parse(localStorage.getItem(RECENT_KEY) ?? "[]") || [];
    const tools = ids.map((id) => toolsById.get(id)).filter((t): t is ToolRecord => Boolean(t));

    recentGrid.innerHTML = "";

    tools.forEach((t) => {
      const a = document.createElement("a");
      a.href = t.href;
      a.className = "tool-card group block overflow-hidden rounded-md border border-line bg-surface transition hover:border-accent";

      if (t.image) {
        const imgWrap = document.createElement("div");
        imgWrap.className = "aspect-video w-full overflow-hidden border-b border-line bg-paper";
        const img = document.createElement("img");
        img.src = t.image;
        img.alt = t.title;
        img.loading = "lazy";
        img.className = "h-full w-full object-cover transition group-hover:scale-105";
        imgWrap.appendChild(img);
        a.appendChild(imgWrap);
      }

      const body = document.createElement("div");
      body.className = "p-4";

      const row = document.createElement("div");
      row.className = "flex items-center justify-between gap-2";

      const h3 = document.createElement("h3");
      h3.className = "truncate font-display text-sm font-semibold text-ink";
      h3.textContent = t.title;

      const cat = document.createElement("span");
      cat.className = "shrink-0 font-mono text-[10px] uppercase text-ink-soft";
      cat.textContent = t.category;

      row.appendChild(h3);
      row.appendChild(cat);

      const desc = document.createElement("p");
      desc.className = "mt-1 line-clamp-2 text-xs text-ink-soft";
      desc.textContent = t.description;

      body.appendChild(row);
      body.appendChild(desc);
      a.appendChild(body);

      recentGrid.appendChild(a);
    });

    recentSection.classList.toggle("hidden", tools.length === 0);
  }

  clearRecentBtn?.addEventListener("click", () => {
    localStorage.removeItem(RECENT_KEY);
    renderRecent();
  });

  renderRecent();

  // Re-render on back/forward nav (bfcache), tab refocus, and Astro view-transitions.
  window.addEventListener("pageshow", () => renderRecent());
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) renderRecent();
  });
  document.addEventListener("astro:page-load", renderRecent);
  document.addEventListener("astro:after-swap", renderRecent);
</script>