---
import "../styles/global.css";
import { BASE_URL } from "../util/config";

export interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
}

const {
  title = "ToolHub - Find the right tool, fast",
  description = "A hand-sorted directory of tools, organized by category and searchable in seconds.",
  keywords = [
  "toolhub",
  "tool directory",
  "software directory",
  "software tools",
  "developer tools",
  "AI tools",
  "productivity tools",
  "design tools",
  "development tools",
  "open source software",
  "coding tools",
  "web development",
  "AI assistants",
  "image editing software",
  "video editing software",
  "media tools",
  "programming software",
  "desktop applications",
  "online tools",
  "best software",
  "free software",
  "find software",
  "software recommendations",
  "technology tools",
  "utility software",
  "creative tools",
  "developer resources",
  "software catalog",
  "tool finder",
  "curated software"
],
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow">
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="keywords" content={keywords.join(', ')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = stored || (prefersDark ? "dark" : "light");
        if (theme === "dark") document.documentElement.classList.add("dark");
      })();
    </script>
  </head>
  <body class="bg-paper text-ink font-body antialiased">
    <header class="sticky top-0 z-30 border-b border-line bg-paper/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href={`${BASE_URL}/`} class="font-display text-2xl font-bold tracking-tight text-ink">
          Tool<span class="text-accent">Hub</span>
        </a>
        <button
          id="theme-toggle"
          aria-label="Toggle color theme"
          class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-md border border-line text-ink transition hover:border-accent"
        >
          <svg class="dark:hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
          <svg class="hidden dark:block h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
          </svg>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-line py-8">
      <div class="mx-auto max-w-6xl px-6 text-center font-mono text-xs text-ink-soft">
        ToolHub - Find the right tool, fast | by <a target="_blank" href="https://bpn.localplayer.dev" class="text-accent-2 hover:text-accent">bpn333</a>
      </div>
    </footer>
    <script>
      const themeToggle = document.getElementById("theme-toggle");

      themeToggle?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
    </script>
  </body>
</html>