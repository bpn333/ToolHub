---
import type { CollectionEntry } from "astro:content";
import { BASE_URL } from "../util/config";

interface Props {
  tool: CollectionEntry<"tools">;
}

const { tool } = Astro.props;
const { title, description, tags, category, image } = tool.data;
const searchBlob = [title, description, category, ...tags].join(" ").toLowerCase();
const initials = category.slice(0, 2).toUpperCase();
const href = `${BASE_URL}/tool/${tool.id}`;
---

<a href={href} class="tool-card" data-category={category} data-search={searchBlob}>
  <div class="aspect-[16/9] w-full overflow-hidden bg-grid flex items-center justify-center">
    {image ? (
      <img src={image} alt={title} class="h-full w-full object-contain" loading="lazy" />
    ) : (
      <span class="font-display text-2xl font-semibold text-ink-soft">{initials}</span>
    )}
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <h3 class="font-display text-lg font-semibold leading-snug text-ink">{title}</h3>
    <p class="text-sm leading-relaxed text-ink-soft line-clamp-2">{description}</p>
    {tags.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-1.5 pt-1">
        {tags.slice(0, 4).map((tag) => (
          <span class="font-mono text-[0.68rem] tracking-wide text-ink-soft">#{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>